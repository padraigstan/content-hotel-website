{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "content-hotel-website.vercel.app"
        }
      ],
      "destination": "https://www.thecontenthotel.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "content-hotel-website.vercel.app"
        }
      ],
      "destination": "https://www.thecontenthotel.com/:path*",
      "permanent": true
    }
  ]
}
